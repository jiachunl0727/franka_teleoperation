--- a/src/robot_impl.cpp
+++ b/src/robot_impl.cpp
@@ -220,6 +220,48 @@ uint32_t Robot::Impl::startMotion(
       throw std::invalid_argument("libfranka robot: Invalid controller mode given.");
   }
 
+  if (startup_state_observer_) {
+    using Move = research_interface::robot::Move;
+    const uint32_t move_id = network_->tcpSendRequest<Move>(
+        controller_mode, motion_generator_mode, maximum_path_deviation, maximum_goal_pose_deviation);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+    try {
+      const auto observe_next = [&]() {
+        if (std::chrono::steady_clock::now() >= deadline) {
+          throw NetworkException("libfranka: observed control startup exceeded one second.");
+        }
+        const auto state = update(nullptr, nullptr);
+        startup_state_observer_(state);
+      };
+      // Keep consuming actual UDP observations while the first Move response is
+      // pending. No torque or motion command is supplied by the observer.
+      while (!network_->tcpReceiveResponse<Move>(move_id, [&](const Move::Response& response) {
+        // This response acknowledges our request. Mode observations may already
+        // show its transition; the ordinary pre-observation check would wrongly
+        // classify a valid MotionStarted acknowledgement as an extra motion.
+        if (response.status != Move::Status::kMotionStarted)
+          handleCommandResponse<Move>(response);
+      })) {
+        observe_next();
+      }
+      while (motion_generator_mode_ != current_move_motion_generator_mode_ ||
+             controller_mode_ != current_move_controller_mode_) {
+        if (network_->tcpReceiveResponse<Move>(move_id, [&](const Move::Response& response) {
+              handleCommandResponse<Move>(response);
+            }))
+          break;
+        observe_next();
+      }
+      logger_.flush();
+      return move_id;
+    } catch (...) {
+      // ControlLoop's constructor has not completed yet, so its usual exception
+      // cancellation is not active. Preserve the initiating exception.
+      try { cancelMotion(move_id); } catch (...) {}
+      throw;
+    }
+  }
+
   const uint32_t move_command_id = executeCommand<research_interface::robot::Move>(
       controller_mode, motion_generator_mode, maximum_path_deviation, maximum_goal_pose_deviation);
 
