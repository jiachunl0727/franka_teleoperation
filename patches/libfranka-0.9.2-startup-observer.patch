+  /**
+   * Torque control with observations of newly received states during startup.
+   * The observer runs on the control owner while awaiting the Move response and
+   * mode transition. It cannot supply commands and must be bounded/non-blocking.
+   * No concurrent read operation or additional connection is created. An observer
+   * exception attempts cancellation and propagates. Startup is bounded to one second (plus the
+   * underlying receive/cancellation timeouts). Ordinary control() is unchanged.
+   */
+  void controlWithStartupObserver(
+      std::function<Torques(const RobotState&, franka::Duration)> control_callback,
+      std::function<void(const RobotState&)> startup_observer,
+      bool limit_rate = true,
+      double cutoff_frequency = kDefaultCutoffFrequency);
+
   /**
    * Starts a control loop for sending joint-level torque commands and joint positions.
    *
