	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_inter_arm_startup_transport.dir/build.make CMakeFiles/test_inter_arm_startup_transport.dir/ws/src/third_party/libfranka_0_9_2/test/mock_server.cpp.i
.PHONY : ws/src/third_party/libfranka_0_9_2/test/mock_server.cpp.i

ws/src/third_party/libfranka_0_9_2/test/mock_server.s: ws/src/third_party/libfranka_0_9_2/test/mock_server.cpp.s
.PHONY : ws/src/third_party/libfranka_0_9_2/test/mock_server.s

# target to generate assembly for a file
ws/src/third_party/libfranka_0_9_2/test/mock_server.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_inter_arm_startup_transport.dir/build.make CMakeFiles/test_inter_arm_startup_transport.dir/ws/src/third_party/libfranka_0_9_2/test/mock_server.cpp.s
